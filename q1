def runcmd(
    cmd: list[str], run_silently: bool = False, show_output: bool = True, timeout: float | None = None
) -> tuple[int, str, str]:
    import subprocess
    import sys

    if not cmd:
        msg = "cmd must be a non-empty list (e.g., ['ls', '-l'])"
        raise ValueError(msg)

    def fail(code: int, msg: str) -> tuple[int, str, str]:
        if show_output and not run_silently:
            print(msg, file=sys.stderr)
        return (code, "", msg)

    try:
        if run_silently:
            result = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=timeout)
            return (result.returncode, "", "")
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        if show_output:
            if result.stdout:
                sys.stdout.write(result.stdout)
                sys.stdout.flush()
            if result.stderr:
                sys.stderr.write(result.stderr)
                sys.stderr.flush()
        return (result.returncode, result.stdout, result.stderr)
    except FileNotFoundError:
        return fail(127, f"Command not found: '{cmd[0]}'")
    except PermissionError:
        return fail(126, f"Permission denied: '{cmd[0]}'")
    except subprocess.TimeoutExpired:
        return fail(124, f"Command timed out after {timeout}s: {' '.join(cmd)}")
    except Exception as e:
        return fail(1, f"Unexpected error running '{cmd[0]}': {e}")

